remove_has_stack_children() {
  local root=$1
  local branch=$2
  stack_ensure_file "$root"
  python3 - "$root" "$branch" <<'PY'
import json, sys
root, br = sys.argv[1:3]
with open(f"{root}/.grov/stack.json") as f:
    nodes = json.load(f).get("nodes") or {}
if br in nodes:
    for _, meta in nodes.items():
        if meta.get("parent") == br:
            sys.exit(2)
sys.exit(0)
PY
}

unmount_symlinks_for_folder() {
  local root=$1
  local folder=$2
  local mname mfolder link_path
  mounts_ensure_file "$root" 2>/dev/null || return 0
  while IFS= read -r mname; do
    [[ -z "$mname" || "$mname" == "$WORKSPACE_MOUNT" ]] && continue
    mfolder=$(mounts_get_folder "$root" "$mname")
    [[ "$mfolder" != "$folder" ]] && continue
    mounts_remove_name "$root" "$mname"
    link_path=$(cd "$root" && pwd)/$mname
    [[ -L "$link_path" || -e "$link_path" ]] && rm -f "$link_path"
    echo "Unmounted $mname"
  done < <(mounts_list_names "$root" 2>/dev/null || true)
}

remove_one_branch() {
  local root=$1
  local branch=$2
  local check_children=$3
  local folder wt_path ws_folder
  folder=$(resolve_target_folder "$root" "$branch") || {
    echo "Error: Could not resolve '$branch'." >&2
    return 1
  }
  ws_folder=$(get_linked_branch "$root" 2>/dev/null) || true
  if [[ -n "$ws_folder" && "$folder" == "$ws_folder" ]]; then
    echo "Error: Cannot remove '$branch' (workspace mount). Switch workspace first." >&2
    return 1
  fi
  if [[ "$check_children" == true ]]; then
    set +e
    remove_has_stack_children "$root" "$branch"
    local rc=$?
    set -e
    if [[ "$rc" -eq 2 ]]; then
      echo "Error: Branch '$branch' has stacked children. Use --cascade or remove children first." >&2
      return 1
    fi
    [[ "$rc" -ne 0 ]] && return "$rc"
  fi
  wt_path=$(get_worktree_path "$root" "$folder")
  wt_path=$(readlink -f "$wt_path" 2>/dev/null || echo "$wt_path")
  if [[ ! -d "$wt_path" ]]; then
    echo "Error: No worktree at $wt_path" >&2
    return 1
  fi
  if has_bare "$root"; then
    git --git-dir="$root/$BARE_REPO" worktree remove "$wt_path"
  else
    local primary_dir
    primary_dir=$(get_primary_dir "$root")
    if [[ "$folder" == "$primary_dir" ]]; then
      echo "Error: Cannot remove the primary worktree ($primary_dir)." >&2
      return 1
    fi
    git -C "$root/$BRANCHES_DIR_NAME/$primary_dir" worktree remove "$wt_path"
  fi
  stack_remove_node "$root" "$branch" 2>/dev/null || true
  unmount_symlinks_for_folder "$root" "$folder"
  echo "Removed worktree: $folder ($branch)"
}

cmd_remove() {
  local root=$1
  shift
  stack_ensure_file "$root"
  require_python3
  stack_scope_parse_args "$root" "$@" || {
    echo "Usage: grov remove [--yes] <branch>|<a>..<b> [--cascade]" >&2
    exit 1
  }
  [[ "$SCR_ALL" == true ]] && {
    echo "Error: grov remove does not support --all." >&2
    exit 1
  }
  [[ "$SCR_MODE" == "all" ]] && {
    echo "Usage: grov remove [--yes] <branch>|<a>..<b> [--cascade]" >&2
    exit 1
  }
  [[ "$SCR_DRY" == true ]] && {
    echo "Error: grov remove does not support --dry-run." >&2
    exit 1
  }

  local header="" branches_list
  case "$SCR_MODE" in
    single) header="Remove '${SCR_ARG}':" ;;
    cascade) header="Remove '${SCR_ARG}' and descendants (leaves first):" ;;
    range) header="Remove chain '${SCR_FROM}..${SCR_TO}' (leaves first):" ;;
  esac
  branches_list=$(stack_scope_resolve_branches_remove_order "$root") || exit 1
  [[ -z "$branches_list" ]] && { echo "Nothing to remove."; return 0; }

  echo "$header"
  local br
  while IFS= read -r br; do
    [[ -z "$br" ]] && continue
    echo "  $br"
  done <<<"$branches_list"

  if [[ "$SCR_YES" != true ]]; then
    local n
    n=$(grep -c . <<<"$branches_list" || echo 0)
    echo -n "Remove $n worktree(s)? [y/N] "
    read -r ans </dev/tty
    [[ "$ans" != [yY]* ]] && return 0
  fi

  local check_children=true
  [[ "$SCR_MODE" != "single" ]] && check_children=false
  while IFS= read -r br; do
    [[ -z "$br" ]] && continue
    remove_one_branch "$root" "$br" "$check_children"
  done <<<"$branches_list"
}

git_state_line() {
  local wt_path=$1
  local linked=$2
  local folder=$3
  local marker=""
  [[ "$folder" == "$linked" ]] && marker=" (linked)"
  local state=""
  local rb="" gp
  gp=$(git -C "$wt_path" rev-parse --git-path rebase-merge 2>/dev/null || true)
  if [[ -n "$gp" && -d "$gp" ]]; then rb=" rebase-in-progress"; fi
  if [[ -z "$rb" ]]; then
    gp=$(git -C "$wt_path" rev-parse --git-path rebase-apply 2>/dev/null || true)
    [[ -n "$gp" && -d "$gp" ]] && rb=" rebase-in-progress"
  fi
  if git -C "$wt_path" rev-parse --is-inside-work-tree &>/dev/null; then
    if [[ -n $(git -C "$wt_path" status -s 2>/dev/null) ]]; then
      state="uncommitted"
    else
      local ahead behind
      ahead=$(git -C "$wt_path" rev-list --count @{u}..HEAD 2>/dev/null || echo "0")
      behind=$(git -C "$wt_path" rev-list --count HEAD..@{u} 2>/dev/null || echo "0")
      if [[ "$ahead" != "0" || "$behind" != "0" ]]; then
        state="ahead $ahead, behind $behind"
      else
        state="clean"
      fi
    fi
  else
    state="?"
  fi
  echo "  $folder$marker  $state$rb"
}

cmd_status() {
  local root=$1
  shift
  local do_fetch=true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-fetch) do_fetch=false ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
    shift
  done
  ensure_workspace "$root" || true
  stack_ensure_file "$root"
  require_python3
  if [[ "$do_fetch" == true && -z "$GROV_NO_FETCH" ]]; then
    if has_bare "$root"; then
      git --git-dir="$root/$BARE_REPO" fetch --all --quiet 2>/dev/null || true
    else
      local primary_dir
      primary_dir=$(get_primary_dir "$root")
      git -C "$root/$BRANCHES_DIR_NAME/$primary_dir" fetch --all --quiet 2>/dev/null || true
    fi
  fi
  local linked=""
  linked=$(get_linked_branch "$root" 2>/dev/null) || true
  [[ -z "$linked" && -L "$root/$LINK_NAME" ]] && linked=$(basename "$(readlink "$root/$LINK_NAME")")
  local base
  base=$(stack_get_base "$root" 2>/dev/null) || true
  if [[ -z "$base" ]]; then
    base=$(cat "$root/.grov/primary-branch" 2>/dev/null) || true
  fi
  local color="0"
  [[ -t 1 && -z "$NO_COLOR" ]] && color="1"
  python3 - "$root" "$linked" "$base" "$color" <<'PY'
import json, os, re, subprocess, sys

root, linked, base = sys.argv[1], sys.argv[2], sys.argv[3]
use_color = sys.argv[4] == "1"

BOLD, DIM, GREEN, YELLOW, CYAN, RED, ORANGE = "1", "2", "32", "33", "36", "31", "38;5;208"
ANSI_RE = re.compile(r"\033\[[0-9;]*m")

def c(code, text):
    if not use_color or not text:
        return text
    return f"\033[{code}m{text}\033[0m"

def vlen(s):
    return len(ANSI_RE.sub("", s))

def is_rebase_in_progress(wt):
    for sub in ("rebase-merge", "rebase-apply"):
        try:
            gp = subprocess.check_output(
                ["git", "-C", wt, "rev-parse", "--git-path", sub],
                stderr=subprocess.DEVNULL, text=True
            ).strip()
        except subprocess.CalledProcessError:
            gp = ""
        if gp and os.path.isdir(gp):
            return True
    return False

def has_unmerged(wt):
    try:
        out = subprocess.check_output(
            ["git", "-C", wt, "diff", "--name-only", "--diff-filter=U"],
            stderr=subprocess.DEVNULL, text=True
        ).strip()
        return bool(out)
    except subprocess.CalledProcessError:
        return False

def get_state(wt, compare_to=None):
    rebase = is_rebase_in_progress(wt)
    if has_unmerged(wt):
        return ("conflict", "rebase conflict" if rebase else "merge conflict")
    if rebase:
        return ("rebasing", "rebase in progress")
    try:
        s = subprocess.check_output(
            ["git", "-C", wt, "status", "-s"],
            stderr=subprocess.DEVNULL, text=True
        )
    except subprocess.CalledProcessError:
        return ("unknown", "?")
    if s.strip():
        ins = dels = 0
        try:
            shortstat = subprocess.check_output(
                ["git", "-C", wt, "diff", "HEAD", "--shortstat"],
                stderr=subprocess.DEVNULL, text=True
            )
            m = re.search(r"(\d+) insertion", shortstat)
            if m: ins = int(m.group(1))
            m = re.search(r"(\d+) deletion", shortstat)
            if m: dels = int(m.group(1))
        except subprocess.CalledProcessError:
            pass
        parts = [c(YELLOW, "uncommitted")]
        if ins or dels:
            parts.append(c(GREEN, f"+{ins}"))
            parts.append(c(RED, f"-{dels}"))
        return ("preformatted", " ".join(parts))
    ref = compare_to if compare_to else "@{u}"
    try:
        ahead = int(subprocess.check_output(
            ["git", "-C", wt, "rev-list", "--count", f"{ref}..HEAD"],
            stderr=subprocess.DEVNULL, text=True
        ).strip() or "0")
        behind = int(subprocess.check_output(
            ["git", "-C", wt, "rev-list", "--count", f"HEAD..{ref}"],
            stderr=subprocess.DEVNULL, text=True
        ).strip() or "0")
    except subprocess.CalledProcessError:
        if compare_to:
            return ("unknown", "?")
        return ("noupstream", "no upstream")
    if not (ahead or behind):
        return ("clean", "clean")
    if not compare_to:
        parts = []
        if ahead: parts.append(f"\u2191{ahead}")
        if behind: parts.append(f"\u2193{behind}")
        return ("diverged", " ".join(parts))
    ins = dels = 0
    if ahead:
        try:
            shortstat = subprocess.check_output(
                ["git", "-C", wt, "diff", "--shortstat", f"{compare_to}...HEAD"],
                stderr=subprocess.DEVNULL, text=True
            )
            m = re.search(r"(\d+) insertion", shortstat)
            if m: ins = int(m.group(1))
            m = re.search(r"(\d+) deletion", shortstat)
            if m: dels = int(m.group(1))
        except subprocess.CalledProcessError:
            pass
    parts = [
        c(CYAN,  f"\u2191{ahead}"),
        c(CYAN,  f"\u2193{behind}"),
        c(GREEN, f"+{ins}"),
        c(RED,   f"-{dels}"),
    ]
    return ("preformatted", " ".join(parts))

def colorize_state(code, text):
    if code == "clean":        return c(GREEN, text)
    if code == "dirty":        return c(YELLOW, text)
    if code == "diverged":     return c(CYAN, text)
    if code == "preformatted": return text
    if code == "conflict":     return c(ORANGE, text)
    if code == "rebasing":     return c(RED, text)
    if code == "noupstream":   return c(DIM, text)
    return text

branches_dir = os.path.join(root, "branches")
folder_to_head = {}
folder_paths = {}
if os.path.isdir(branches_dir):
    for name in sorted(os.listdir(branches_dir)):
        p = os.path.join(branches_dir, name)
        if not os.path.isdir(p):
            continue
        wt = os.path.realpath(p)
        folder_paths[name] = wt
        try:
            h = subprocess.check_output(
                ["git", "-C", wt, "rev-parse", "--abbrev-ref", "HEAD"],
                stderr=subprocess.DEVNULL, text=True
            ).strip()
        except subprocess.CalledProcessError:
            h = "?"
        folder_to_head[name] = h

def rebase_branch_name(wt):
    for sub in ("rebase-merge", "rebase-apply"):
        try:
            gp = subprocess.check_output(
                ["git", "-C", wt, "rev-parse", "--git-path", sub],
                stderr=subprocess.DEVNULL, text=True
            ).strip()
        except subprocess.CalledProcessError:
            continue
        head_name = os.path.join(gp, "head-name")
        if os.path.isfile(head_name):
            with open(head_name) as f:
                ref = f.read().strip()
            if ref.startswith("refs/heads/"):
                return ref[len("refs/heads/"):]
    return None

folder_to_rebase = {}
for fd, wt in folder_paths.items():
    folder_to_rebase[fd] = rebase_branch_name(wt)

with open(os.path.join(root, ".grov", "stack.json")) as f:
    nodes = (json.load(f).get("nodes") or {})

stack_branches = set(nodes.keys())
stack_roots = sorted(
    [b for b, m in nodes.items() if (m.get("parent") or "") not in stack_branches]
)
trunks_seen = set()
trunks = []
for rt in stack_roots:
    par = nodes[rt].get("parent") or ""
    if par and par not in trunks_seen:
        trunks.append(par)
        trunks_seen.add(par)
headless_roots = [r for r in stack_roots if not (nodes[r].get("parent") or "")]
displayed_branches = stack_branches | set(trunks)

def find_folder(branch):
    for fd, h in folder_to_head.items():
        if h == branch:
            return fd
    for fd, rb in folder_to_rebase.items():
        if rb == branch:
            return fd
    meta = nodes.get(branch) or {}
    for candidate in (meta.get("worktree_dir"), branch):
        if candidate and candidate in folder_paths:
            return candidate
    return None

def children_of(name):
    if name in stack_branches:
        return sorted([k for k, m in nodes.items() if m.get("parent") == name])
    if name in trunks_seen:
        return sorted(
            [r for r in stack_roots if (nodes[r].get("parent") or "") == name]
        )
    return []

items = []

def resolve_upstream(wt, branch_hint=None):
    """Return (local_ref, upstream_ref) for ahead/behind; works during rebase/detached HEAD."""
    if not branch_hint:
        branch_hint = rebase_branch_name(wt)
    if not branch_hint:
        try:
            h = subprocess.check_output(
                ["git", "-C", wt, "rev-parse", "--abbrev-ref", "HEAD"],
                stderr=subprocess.DEVNULL, text=True
            ).strip()
            if h and h != "HEAD":
                branch_hint = h
        except subprocess.CalledProcessError:
            pass
    if branch_hint:
        try:
            subprocess.check_output(
                ["git", "-C", wt, "rev-parse", branch_hint],
                stderr=subprocess.DEVNULL, text=True
            )
        except subprocess.CalledProcessError:
            branch_hint = None
    if branch_hint:
        try:
            upstream = subprocess.check_output(
                ["git", "-C", wt, "rev-parse", "--abbrev-ref", f"{branch_hint}@{{upstream}}"],
                stderr=subprocess.DEVNULL, text=True
            ).strip()
            if upstream:
                return branch_hint, upstream
        except subprocess.CalledProcessError:
            pass
        try:
            subprocess.check_output(
                ["git", "-C", wt, "rev-parse", f"origin/{branch_hint}"],
                stderr=subprocess.DEVNULL, text=True
            )
            return branch_hint, f"origin/{branch_hint}"
        except subprocess.CalledProcessError:
            pass
    try:
        subprocess.check_output(
            ["git", "-C", wt, "rev-parse", "@{u}"],
            stderr=subprocess.DEVNULL, text=True
        )
        return "HEAD", "@{u}"
    except subprocess.CalledProcessError:
        return None, None

def get_remote_diff(wt, branch_hint=None):
    local_ref, upstream = resolve_upstream(wt, branch_hint)
    if not upstream:
        return c(DIM, "no remote")
    try:
        ahead = int(subprocess.check_output(
            ["git", "-C", wt, "rev-list", "--count", f"{upstream}..{local_ref}"],
            stderr=subprocess.DEVNULL, text=True
        ).strip() or "0")
        behind = int(subprocess.check_output(
            ["git", "-C", wt, "rev-list", "--count", f"{local_ref}..{upstream}"],
            stderr=subprocess.DEVNULL, text=True
        ).strip() or "0")
    except subprocess.CalledProcessError:
        return ""
    if not (ahead or behind):
        return ""
    parts = []
    if ahead: parts.append(c(CYAN, f"\u21e1{ahead}"))
    if behind: parts.append(c(CYAN, f"\u21e3{behind}"))
    return " ".join(parts)

def fmt_row(name, prefix, is_orphan, parent_name=None):
    if is_orphan:
        folder = name
        head = folder_to_head.get(name, "?")
    else:
        folder = find_folder(name)
        head = name
    is_linked = folder is not None and folder == linked
    sc = st = None
    if folder is not None and folder in folder_paths:
        try:
            sc, st = get_state(folder_paths[folder], compare_to=parent_name)
        except Exception:
            sc, st = ("unknown", "?")
    mark = c(GREEN, "\u25cf") if is_linked else " "
    conflict_mark = c(ORANGE, "!") if sc == "conflict" else ""
    if sc == "conflict":
        name_disp = c(f"{BOLD};{ORANGE}", name) if is_linked else c(ORANGE, name)
    elif is_linked:
        name_disp = c(BOLD, name)
    else:
        name_disp = name
    suffix = ""
    if not is_orphan and folder and folder != name:
        suffix = " " + c(DIM, f"[wt: {folder}]")
    if is_orphan and head != "?" and head != name:
        suffix = " " + c(DIM, f"[head: {head}]")
    if base and name == base:
        suffix += " " + c(DIM, "(base)")
    left = f"{mark}{conflict_mark}{c(DIM, prefix)}{name_disp}{suffix}"
    if folder is None or folder not in folder_paths:
        right = c(DIM, "(no worktree)")
    elif sc is None:
        right = "?"
    else:
        right = colorize_state(sc, st)
        if parent_name is not None:
            branch_hint = name if not is_orphan else folder_to_head.get(name)
            rdiff = get_remote_diff(folder_paths[folder], branch_hint=branch_hint)
            if rdiff:
                right = f"{right}  {rdiff}"
    return left, right

INDENT = "  "

def render(name, prefix_for_this, prefix_for_kids, parent_name=None):
    left, right = fmt_row(name, prefix_for_this, is_orphan=False, parent_name=parent_name)
    items.append(("row", left, right))
    kids = children_of(name)
    for i, k in enumerate(kids):
        last = i == len(kids) - 1
        connector = "\u2514\u2500\u2500 " if last else "\u251c\u2500\u2500 "
        ext = "    " if last else "\u2502   "
        render(k, prefix_for_kids + connector, prefix_for_kids + ext, parent_name=name)

def branches_in_conflict():
    seen = set()
    out = []
    for b in sorted(displayed_branches):
        fd = find_folder(b)
        if not fd or fd not in folder_paths:
            continue
        try:
            sc, _ = get_state(folder_paths[fd])
        except Exception:
            continue
        if sc == "conflict" and b not in seen:
            seen.add(b)
            out.append(b)
    for fd in sorted(folder_paths.keys()):
        if fd in displayed_branches:
            continue
        try:
            sc, _ = get_state(folder_paths[fd])
        except Exception:
            continue
        if sc == "conflict" and fd not in seen:
            seen.add(fd)
            out.append(fd)
    return out

def branch_name_for_linked_folder(folder):
    if not folder:
        return ""
    for b in sorted(displayed_branches):
        if find_folder(b) == folder:
            return b
    return folder

linked_branch = branch_name_for_linked_folder(linked)

mounts_path = os.path.join(root, ".grov", "mounts.json")
mounts = {}
if os.path.isfile(mounts_path):
    with open(mounts_path) as f:
        mounts = json.load(f).get("mounts") or {}
if not mounts and linked:
    mounts = {"workspace": linked}

items.append(("section", "Mounts"))
if not mounts:
    items.append(("dim", f"{INDENT}(none)"))
else:
    for mname in sorted(mounts.keys()):
        folder = mounts[mname] or ""
        head = folder_to_head.get(folder, "?") if folder else "?"
        target = head if head and head != "?" else (folder or "?")
        suffix = ""
        if folder and folder != target:
            suffix = " " + c(DIM, f"[wt: {folder}]")
        name_disp = c(BOLD, mname) if mname == "workspace" else mname
        conn = c(BOLD, target) if mname == "workspace" else target
        line_extra = ""
        if folder and folder in folder_paths:
            try:
                sc, st = get_state(folder_paths[folder])
                if sc == "conflict":
                    line_extra = " " + c(ORANGE, st)
            except Exception:
                pass
        items.append(("text", f"{INDENT}{name_disp} {c(DIM, '\u2192')} {conn}{suffix}{line_extra}"))

conflicts = branches_in_conflict()
other_conflicts = [b for b in conflicts if b != linked_branch]
if other_conflicts:
    items.append(("text", f"{c(DIM, 'Conflict:')} {c(ORANGE, ', '.join(other_conflicts))}"))
items.append(("blank",))

items.append(("section", "Stack"))
if not nodes:
    items.append(("dim", f"{INDENT}(empty)"))
else:
    for trunk in trunks:
        render(trunk, INDENT, INDENT)
    for r in headless_roots:
        render(r, INDENT, INDENT)

orphan_folders = [
    fd for fd, h in folder_to_head.items()
    if h not in displayed_branches and fd not in displayed_branches
]
if orphan_folders:
    items.append(("blank",))
    items.append(("section", "Orphans"))
    for fd in sorted(orphan_folders):
        left, right = fmt_row(fd, INDENT, is_orphan=True)
        items.append(("row", left, right))

maxw = 0
for it in items:
    if it[0] == "row" and vlen(it[1]) > maxw:
        maxw = vlen(it[1])

for it in items:
    kind = it[0]
    if kind == "row":
        _, l, r = it
        pad = " " * (maxw - vlen(l) + 4)
        print(f"{l}{pad}{r}")
    elif kind == "section":
        title = it[1]
        print(c(BOLD, title))
        print(c(DIM, "\u2500" * len(title)))
    elif kind == "blank":
        print()
    elif kind == "dim":
        print(c(DIM, it[1]))
    elif kind == "text":
        print(it[1])
PY
}

find_rebase_worktrees() {
  local root=$1
  local dir wt_path gp
  dir="$root/$BRANCHES_DIR_NAME"
  [[ ! -d "$dir" ]] && return 0
  for d in "$dir"/*/; do
    [[ -d "$d" ]] || continue
    wt_path=$(readlink -f "$d" 2>/dev/null || echo "$d")
    gp=$(git -C "$wt_path" rev-parse --git-path rebase-merge 2>/dev/null || true)
    if [[ -n "$gp" && -d "$gp" ]]; then
      echo "$wt_path"
      continue
    fi
    gp=$(git -C "$wt_path" rev-parse --git-path rebase-apply 2>/dev/null || true)
    [[ -n "$gp" && -d "$gp" ]] && echo "$wt_path"
  done
}

resolve_dirs_for_branch_head() {
  local root=$1
  local git_branch=$2
  local folder
  folder=$(resolve_worktree_folder "$root" "$git_branch") && echo "1 $folder" || echo "0 "
}

materialize_worktree_if_needed() {
  local root=$1
  local branch=$2
  local info n d
  info=$(resolve_dirs_for_branch_head "$root" "$branch")
  n=${info%% *}
  if [[ "$n" -eq 1 ]]; then return 0; fi
  if [[ "$n" -gt 1 ]]; then
    echo "Error: Multiple worktrees have HEAD=$branch; resolve manually." >&2
    exit 1
  fi
  ensure_worktree "$root" false "$branch"
}

cmd_restack() {
  local root=$1
  shift
  if [[ "$1" == "--continue" ]]; then
    cmd_restack_continue "$root"
    return
  fi
  if [[ "$1" == "--abort" ]]; then
    cmd_restack_abort "$root"
    return
  fi
  stack_ensure_file "$root"
  require_python3
  stack_scope_parse_args "$root" "$@" || {
    echo "Usage: grov restack [--all] [--yes] [--continue|--abort] [[<branch>|<a>..<b>] [--cascade]]" >&2
    exit 1
  }

  local header="" branches_filter="" mapfile_order
  case "$SCR_MODE" in
    all) header="Restack all stacked branches (parent order):" ;;
    single) header="Restack '${SCR_ARG}':" ;;
    cascade) header="Restack '${SCR_ARG}' and descendants (parent order):" ;;
    range) header="Restack chain '${SCR_FROM}..${SCR_TO}' (parent order):" ;;
  esac

  branches_filter=$(stack_scope_resolve_branches "$root")
  mapfile -t mapfile_order < <(collect_restack_pairs "$root" "$branches_filter")
  if [[ ${#mapfile_order[@]} -eq 0 ]]; then
    echo "Nothing to restack."
    return 0
  fi

  echo "$header"
  local line child parent
  for line in "${mapfile_order[@]}"; do
    IFS=$'\t' read -r child parent <<<"$line"
    echo "  $child onto $parent"
  done

  if [[ "$SCR_YES" != true && "$SCR_ALL" != true ]]; then
    echo -n "Restack ${#mapfile_order[@]} branch(es)? [y/N] "
    read -r ans </dev/tty
    [[ "$ans" != [yY]* ]] && return 0
  fi

  for line in "${mapfile_order[@]}"; do
    IFS=$'\t' read -r child parent <<<"$line"
    [[ -z "$child" ]] && continue
    materialize_worktree_if_needed "$root" "$child"
    local wt_folder
    wt_folder=$(resolve_worktree_folder "$root" "$child") || {
      echo "Error: Could not resolve worktree for branch $child" >&2
      exit 1
    }
    local wt_path
    wt_path=$(readlink -f "$(get_worktree_path "$root" "$wt_folder")")
    echo "Restack: $child onto $parent (in $wt_path)"
    if git -C "$wt_path" rebase "$parent"; then
      :
    else
      cmd_switch "$root" "$wt_folder"
      echo "" >&2
      echo "Rebase conflict while restacking branch '$child'." >&2
      echo "Resolve in: $wt_path" >&2
      echo "workspace -> branches/$wt_folder (linked for conflict resolution)" >&2
      echo "Then run: grov restack --continue   (or: git -C \"$wt_path\" rebase --continue)" >&2
      exit 1
    fi
  done
  echo "Restack complete."
}

cmd_restack_continue() {
  local root=$1
  local list wt n
  mapfile -t list < <(find_rebase_worktrees "$root")
  n=${#list[@]}
  if [[ "$n" -eq 0 ]]; then
    echo "Error: No rebase in progress in any branches/* worktree." >&2
    exit 1
  fi
  if [[ "$n" -gt 1 ]]; then
    echo "Error: Multiple rebases in progress; resolve one at a time." >&2
    printf '%s\n' "${list[@]}" >&2
    exit 1
  fi
  wt="${list[0]}"
  git -C "$wt" rebase --continue
}

cmd_restack_abort() {
  local root=$1
  local list wt n
  mapfile -t list < <(find_rebase_worktrees "$root")
  n=${#list[@]}
  if [[ "$n" -eq 0 ]]; then
    echo "Error: No rebase in progress in any branches/* worktree." >&2
    exit 1
  fi
  if [[ "$n" -gt 1 ]]; then
    echo "Error: Multiple rebases in progress." >&2
    exit 1
  fi
  wt="${list[0]}"
  git -C "$wt" rebase --abort
}

collect_subtree_branches() {
  local root=$1
  local start=$2
  require_python3
  python3 - "$root" "$start" <<'PY'
import json, os, sys, collections

root, start = sys.argv[1:3]
with open(os.path.join(root, ".grov", "stack.json")) as f:
    nodes = json.load(f).get("nodes") or {}

if start not in nodes:
    print(start)
    sys.exit(0)

children = collections.defaultdict(list)
for b, m in nodes.items():
    p = m.get("parent")
    if p:
        children[p].append(b)

seen = set()
q = collections.deque([start])
out = []
while q:
    b = q.popleft()
    if b in seen:
        continue
    seen.add(b)
    out.append(b)
    for c in sorted(children.get(b, [])):
        q.append(c)

def depth(b):
    if b not in nodes:
        return 0
    p = nodes[b].get("parent")
    if not p or p not in nodes:
        return 0
    return 1 + depth(p)

# push parents before children => smaller depth first
for b in sorted(seen, key=lambda x: (depth(x), x)):
    print(b)
PY
}

# Walk parent chain from <to> (incl) up to <from> (excl); emits parent-first.
collect_stack_range() {
  local root=$1
  local from=$2
  local to=$3
  require_python3
  python3 - "$root" "$from" "$to" <<'PY'
import json, os, sys
root, frm, to = sys.argv[1:4]
with open(os.path.join(root, ".grov", "stack.json")) as f:
    nodes = json.load(f).get("nodes") or {}
chain = []
cur = to
while cur != frm:
    chain.append(cur)
    if cur not in nodes:
        print(f"Error: '{cur}' is not in the stack; cannot walk to '{frm}'.", file=sys.stderr)
        sys.exit(1)
    p = nodes[cur].get("parent")
    if not p:
        print(f"Error: '{frm}' is not an ancestor of '{to}' in the stack.", file=sys.stderr)
        sys.exit(1)
    cur = p
for b in reversed(chain):
    print(b)
PY
}

# All stack nodes (depth order) plus worktree HEAD branches not already listed.
collect_all_branches() {
  local root=$1
  require_python3
  stack_ensure_file "$root"
  python3 - "$root" "$BRANCHES_DIR_NAME" <<'PY'
import json, os, subprocess, sys

root, branches_dir = sys.argv[1:3]
with open(os.path.join(root, ".grov", "stack.json")) as f:
    nodes = json.load(f).get("nodes") or {}

def depth(b):
    if b not in nodes:
        return 0
    d, cur, seen = 0, b, set()
    while cur in nodes and cur not in seen:
        seen.add(cur)
        p = nodes[cur].get("parent")
        if not p or p not in nodes:
            break
        d += 1
        cur = p
    return d

seen = set()
out = []
for b in sorted(nodes.keys(), key=lambda x: (depth(x), x)):
    if b not in seen:
        seen.add(b)
        out.append(b)

bd = os.path.join(root, branches_dir)
if os.path.isdir(bd):
    for folder in sorted(os.listdir(bd)):
        p = os.path.join(bd, folder)
        if not os.path.isdir(p):
            continue
        try:
            head = subprocess.check_output(
                ["git", "-C", p, "rev-parse", "--abbrev-ref", "HEAD"],
                stderr=subprocess.DEVNULL, text=True,
            ).strip()
        except subprocess.CalledProcessError:
            head = folder
        if head and head != "HEAD" and head not in seen:
            seen.add(head)
            out.append(head)
        elif folder not in seen and folder not in out:
            seen.add(folder)
            out.append(folder)

for b in out:
    print(b)
PY
}

# child<TAB>parent lines for restack; optional second arg is newline-separated branch filter.
collect_restack_pairs() {
  local root=$1
  local filter_list="${2:-}"
  require_python3
  stack_ensure_file "$root"
  python3 - "$root" "$filter_list" <<'PY'
import json, os, sys

root = sys.argv[1]
raw = sys.argv[2] if len(sys.argv) > 2 else ""
filters = [ln.strip() for ln in raw.splitlines() if ln.strip()]
allow = set(filters) if filters else None

with open(os.path.join(root, ".grov", "stack.json")) as f:
    nodes = json.load(f).get("nodes") or {}

def depth(b):
    if b not in nodes:
        return 0
    d, cur, seen = 0, b, set()
    while cur in nodes and cur not in seen:
        seen.add(cur)
        p = nodes[cur].get("parent")
        if not p or p not in nodes:
            break
        d += 1
        cur = p
    return d

ordered = sorted(nodes.keys(), key=lambda b: (depth(b), b))
for child in ordered:
    if allow is not None and child not in allow:
        continue
    par = nodes[child].get("parent")
    if not par:
        continue
    print(f"{child}\t{par}")
PY
}

# Sets: SCR_YES SCR_ALL SCR_CASCADE SCR_DRY SCR_MODE SCR_ARG SCR_FROM SCR_TO
# SCR_MODE: all | single | cascade | range
stack_scope_default_branch() {
  local root=$1
  get_linked_git_branch "$root" 2>/dev/null || get_linked_branch "$root" 2>/dev/null || true
}

# Optional: pass root as $1 for --cascade default branch. Rejects --single (removed).
stack_scope_parse_args() {
  local root="${1:-}"
  [[ -n "$root" && "$root" != --* ]] && shift || root=""
  SCR_YES=false
  SCR_ALL=false
  SCR_CASCADE=false
  SCR_DRY=false
  SCR_MODE=""
  SCR_ARG=""
  SCR_FROM=""
  SCR_TO=""
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) SCR_YES=true ;;
      --all) SCR_ALL=true ;;
      --cascade) SCR_CASCADE=true ;;
      --single) echo "Error: --single was removed; use a branch alone for one target, or --cascade for descendants." >&2; return 1 ;;
      --dry-run) SCR_DRY=true ;;
      -*) echo "Unknown option: $1" >&2; return 1 ;;
      *) positional+=("$1") ;;
    esac
    shift
  done
  if [[ ${#positional[@]} -gt 1 ]]; then
    echo "Error: too many positional arguments." >&2
    return 1
  fi
  if [[ ${#positional[@]} -eq 1 ]]; then
    SCR_ARG="${positional[0]}"
    if [[ "$SCR_ARG" == *..*..* ]]; then
      echo "Error: invalid range syntax '$SCR_ARG' (expected <a>..<b>)." >&2
      return 1
    fi
    if [[ "$SCR_ARG" == *..* ]]; then
      [[ "$SCR_CASCADE" == true ]] && {
        echo "Error: --cascade cannot be used with a range (a..b)." >&2
        return 1
      }
      SCR_MODE="range"
      SCR_FROM="${SCR_ARG%%..*}"
      SCR_TO="${SCR_ARG##*..}"
      [[ -z "$SCR_FROM" || -z "$SCR_TO" ]] && {
        echo "Error: invalid range '$SCR_ARG'." >&2
        return 1
      }
    elif [[ "$SCR_CASCADE" == true ]]; then
      SCR_MODE="cascade"
    else
      SCR_MODE="single"
    fi
  elif [[ "$SCR_CASCADE" == true ]]; then
    [[ -z "$root" ]] && {
      echo "Error: --cascade without a branch requires a grov project root." >&2
      return 1
    }
    SCR_ARG=$(stack_scope_default_branch "$root")
    [[ -z "$SCR_ARG" ]] && {
      echo "Error: --cascade requires a branch (no workspace mount)." >&2
      return 1
    }
    SCR_MODE="cascade"
  else
    SCR_MODE="all"
  fi
  return 0
}

# Echo branch list (one per line). Uses SCR_* from stack_scope_parse_args.
stack_scope_resolve_branches() {
  local root=$1
  case "$SCR_MODE" in
    all) collect_all_branches "$root" ;;
    single) echo "$SCR_ARG" ;;
    cascade) collect_subtree_branches "$root" "$SCR_ARG" ;;
    range) collect_stack_range "$root" "$SCR_FROM" "$SCR_TO" ;;
  esac
}

# Leaves-first order for remove (reverse parent-before-child list).
stack_scope_resolve_branches_remove_order() {
  local root=$1
  local lines
  lines=$(stack_scope_resolve_branches "$root")
  [[ -z "$lines" ]] && return 0
  if [[ "$SCR_MODE" == "single" ]]; then
    echo "$lines"
    return 0
  fi
  tac <<<"$lines" 2>/dev/null || tail -r <<<"$lines"
}

worktree_in_rebase() {
  local wt_path=$1
  local gp sub
  for sub in rebase-merge rebase-apply; do
    gp=$(git -C "$wt_path" rev-parse --git-path "$sub" 2>/dev/null || true)
    if [[ -n "$gp" && -d "$gp" ]]; then return 0; fi
  done
  return 1
}

worktree_path_for_branch() {
  local root=$1
  local branch=$2
  local folder wt_path
  folder=$(resolve_worktree_folder "$root" "$branch" 2>/dev/null) || folder="$branch"
  wt_path=$(readlink -f "$(get_worktree_path "$root" "$folder")" 2>/dev/null || get_worktree_path "$root" "$folder")
  if [[ ! -d "$wt_path" ]]; then
    ensure_worktree "$root" false "$branch"
    folder=$(resolve_worktree_folder "$root" "$branch" 2>/dev/null) || folder="$branch"
    wt_path=$(readlink -f "$(get_worktree_path "$root" "$folder")" 2>/dev/null || get_worktree_path "$root" "$folder")
  fi
  [[ -d "$wt_path" ]] || return 1
  echo "$wt_path"
}

cmd_mount() {
  local root=$1
  shift
  local name="$1" branch="$2"
  [[ -z "$name" || -z "$branch" ]] && { echo "Usage: grov mount <name> <branch>" >&2; exit 1; }
  [[ "$name" == "$WORKSPACE_MOUNT" ]] && {
    echo "Error: Use grov checkout/switch to change the workspace mount." >&2
    exit 1
  }
  mount_name_valid "$name" || {
    echo "Error: Invalid mount name '$name' (use letters, digits, _, -; not branches/.grov/.git)." >&2
    exit 1
  }
  [[ -e "$root/$name" && ! -L "$root/$name" ]] && {
    echo "Error: '$name' exists and is not a symlink." >&2
    exit 1
  }
  ensure_worktree "$root" false "$branch"
  local folder
  folder=$(resolve_target_folder "$root" "$branch") || {
    echo "Error: Could not resolve worktree for '$branch'." >&2
    exit 1
  }
  mounts_set_folder "$root" "$name" "$folder"
  apply_mount_symlink "$root" "$name" "$folder"
  echo "Mounted $name -> branches/$folder"
}

cmd_unmount() {
  local root=$1
  shift
  local name="$1"
  [[ -z "$name" ]] && { echo "Usage: grov unmount <name>" >&2; exit 1; }
  [[ "$name" == "$WORKSPACE_MOUNT" ]] && {
    echo "Error: Cannot unmount required mount '$WORKSPACE_MOUNT'." >&2
    exit 1
  }
  mounts_ensure_file "$root"
  local folder
  folder=$(mounts_get_folder "$root" "$name")
  [[ -z "$folder" ]] && { echo "Error: No mount named '$name'." >&2; exit 1; }
  mounts_remove_name "$root" "$name"
  local link_path
  link_path=$(cd "$root" && pwd)/$name
  [[ -L "$link_path" || -e "$link_path" ]] && rm -f "$link_path"
  echo "Unmounted $name"
}

cmd_mounts() {
  local root=$1
  mounts_ensure_file "$root"
  require_python3
  python3 - "$root" "$BRANCHES_DIR_NAME" <<'PY'
import json, os, sys
root, branches = sys.argv[1:3]
with open(os.path.join(root, ".grov", "mounts.json")) as f:
    mounts = json.load(f).get("mounts") or {}
for name in sorted(mounts.keys()):
    folder = mounts[name] or "?"
    link = os.path.join(root, name)
    path = ""
    if os.path.islink(link):
        path = os.path.realpath(link)
    elif folder and folder != "?":
        path = os.path.join(root, branches, folder)
    print(f"{name}\t{folder}\t{path}")
PY
}

cmd_work() {
  local root=$1
  shift
  local target="${1:-}" via_mount="" folder wt_path ws_folder git_branch shell
  if [[ -z "$target" ]]; then
    folder=$(get_linked_branch "$root") || {
      echo "Error: No workspace mount; use: grov work <branch|mount>" >&2
      exit 1
    }
    target="$folder"
  else
    mounts_ensure_file "$root"
    local mount_folder
    mount_folder=$(mounts_get_folder "$root" "$target")
    if [[ -n "$mount_folder" ]]; then
      folder="$mount_folder"
      via_mount="$target"
    fi
  fi
  [[ -z "$folder" ]] && folder=$(resolve_target_folder "$root" "$target") || {
    echo "Error: Could not resolve '$target'. Use: grov add <branch>" >&2
    exit 1
  }
  wt_path=$(worktree_path_for_branch "$root" "$folder") || {
    echo "Error: No worktree for '$folder'." >&2
    exit 1
  }
  if worktree_in_rebase "$wt_path"; then
    echo "Error: '$folder' is mid-rebase; resolve with grov restack --continue first." >&2
    exit 1
  fi
  ws_folder=$(get_linked_branch "$root" 2>/dev/null) || ws_folder="(none)"
  git_branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null) || git_branch="$folder"
  [[ "$git_branch" == "HEAD" ]] && git_branch="$folder"
  echo "grov work: $git_branch @ $wt_path (workspace mount still: $ws_folder)${via_mount:+ via mount $via_mount}"
  export GROV_ROOT="$root"
  export GROV_WT="$wt_path"
  export GROV_BRANCH="$git_branch"
  export GROV_WORKSPACE_MOUNT="$ws_folder"
  [[ -n "$via_mount" ]] && export GROV_MOUNT="$via_mount"
  shell=${SHELL:-/bin/bash}
  cd "$wt_path" && exec "$shell"
}

cmd_merge() {
  local root=$1
  shift
  local source="" target=""
  case $# in
    0)
      echo "Usage: grov merge [<branch-a>] [<branch-b>]" >&2
      exit 1
      ;;
    1) source="$1" ;;
    2) source="$1"; target="$2" ;;
    *)
      echo "Usage: grov merge [<branch-a>] [<branch-b>]" >&2
      exit 1
      ;;
  esac
  [[ -z "$target" ]] && target=$(get_linked_git_branch "$root" 2>/dev/null || true)
  [[ -z "$target" ]] && target=$(get_linked_branch "$root")
  [[ -z "$target" ]] && { echo "Error: No target branch; link workspace or pass two branch names." >&2; exit 1; }
  local source_wt target_wt source_ref
  source_wt=$(worktree_path_for_branch "$root" "$source") || {
    echo "Error: No worktree for source branch '$source'." >&2
    exit 1
  }
  target_wt=$(worktree_path_for_branch "$root" "$target") || {
    echo "Error: No worktree for target branch '$target'." >&2
    exit 1
  }
  if worktree_in_rebase "$target_wt"; then
    echo "Error: '$target' is mid-rebase; resolve with grov restack --continue first." >&2
    exit 1
  fi
  source_ref=$(git -C "$source_wt" rev-parse --abbrev-ref HEAD 2>/dev/null) || source_ref="$source"
  [[ "$source_ref" == "HEAD" ]] && source_ref="$source"
  echo "Merge $source_ref into $target (in $target_wt)"
  git -C "$target_wt" merge "$source_ref"
}

cmd_exec() {
  local root=$1
  shift
  local branch="${1:-}"
  shift || true
  [[ -z "$branch" || "${1:-}" != "--" ]] && { echo "Usage: grov exec <branch> -- <cmd...>" >&2; exit 1; }
  shift
  [[ $# -eq 0 ]] && { echo "Usage: grov exec <branch> -- <cmd...>" >&2; exit 1; }
  local wt_path
  wt_path=$(get_worktree_path "$root" "$branch")
  [[ ! -d "$wt_path" ]] && { echo "Error: No worktree at $wt_path." >&2; exit 1; }
  export GROV_ROOT="$root"
  cd "$wt_path" && exec "$@"
}

cmd_push() {
  local root=$1
  shift
  stack_ensure_file "$root"
  require_python3
  stack_scope_parse_args "$root" "$@" || {
    echo "Usage: grov push [--all] [--yes] [--dry-run] [[<branch>|<a>..<b>] [--cascade]]" >&2
    exit 1
  }

  local yes=false dry=false
  [[ "$SCR_YES" == true || "$SCR_ALL" == true ]] && yes=true
  [[ "$SCR_DRY" == true ]] && dry=true

  local branches_list="" header=""
  case "$SCR_MODE" in
    all) header="Push all pushable branches (parent-before-child):" ;;
    single) header="Push '${SCR_ARG}':" ;;
    cascade) header="Push '${SCR_ARG}' and descendants (parent-before-child):" ;;
    range) header="Push chain '${SCR_FROM}..${SCR_TO}' (parent-before-child):" ;;
  esac
  branches_list=$(stack_scope_resolve_branches "$root") || exit 1
  [[ "$SCR_MODE" == "range" ]] && [[ -z "$branches_list" ]] && exit 1

  echo "$header"
  local -a planned_branches=()
  while IFS= read -r br; do
    [[ -z "$br" ]] && continue
    planned_branches+=("$br")
  done <<<"$branches_list"

  local -a do_branches=() do_wtpaths=() do_kinds=() do_remotes=() do_push_names=()
  local br wt_path info n d ahead behind ab
  for br in "${planned_branches[@]}"; do
    materialize_worktree_if_needed "$root" "$br"
    info=$(resolve_dirs_for_branch_head "$root" "$br")
    d=${info#* }
    wt_path=$(readlink -f "$(get_worktree_path "$root" "${d%% *}")" 2>/dev/null || get_worktree_path "$root" "${d%% *}")
    if ! push_resolve_upstream "$wt_path" "$br" &>/dev/null; then
      echo "  $br: no upstream"
      do_branches+=("$br")
      do_wtpaths+=("$wt_path")
      do_kinds+=("setup")
      do_remotes+=("origin")
      do_push_names+=("$br")
      continue
    fi
    ab=$(push_ahead_behind "$wt_path" "$br")
    ahead=${ab%% *}
    behind=${ab#* }
    if [[ "$ahead" == "0" && "$behind" == "0" ]]; then
      echo "  $br: nothing to push"
      continue
    fi
    if [[ "$ahead" == "0" ]]; then
      echo "  $br: behind $behind (nothing to push)"
      continue
    fi
    local ab_msg="ahead $ahead"
    [[ "$behind" != "0" ]] && ab_msg="$ab_msg, behind $behind"
    echo "  $br: $ab_msg (push with --force-with-lease)"
    do_branches+=("$br")
    do_wtpaths+=("$wt_path")
    do_kinds+=("push")
    do_remotes+=("origin")
    do_push_names+=("$br")
  done

  local n=${#do_branches[@]}
  [[ "$n" -eq 0 ]] && return 0

  if [[ "$dry" == true ]]; then
    local i
    for ((i = 0; i < n; i++)); do
      if [[ "${do_kinds[$i]}" == "setup" ]]; then
        echo "    dry-run: git push --set-upstream ${do_remotes[$i]} ${do_branches[$i]}:${do_push_names[$i]}"
      else
        echo "    dry-run: git push --force-with-lease ${do_remotes[$i]} ${do_branches[$i]}"
      fi
    done
    return 0
  fi

  if [[ "$yes" != true ]]; then
    echo -n "Push $n branch(es)? [y/N] "
    read -r ans </dev/tty
    [[ "$ans" != [yY]* ]] && return 0
  fi

  local i remote push_branch upstream_input
  for ((i = 0; i < n; i++)); do
    br="${do_branches[$i]}"
    wt_path="${do_wtpaths[$i]}"
    if [[ "${do_kinds[$i]}" == "setup" ]]; then
      remote="${do_remotes[$i]}"
      push_branch="${do_push_names[$i]}"
      if [[ "$yes" != true ]]; then
        echo -n "  $br: set upstream to [$remote/$push_branch]? [y/N] "
        read -r upstream_input </dev/tty
        [[ "$upstream_input" != [yY]* ]] && continue
      fi
      echo "  $br: setting upstream to $remote/$push_branch"
      git -C "$wt_path" push --set-upstream "$remote" "$br:$push_branch"
      continue
    fi
    git -C "$wt_path" push --force-with-lease "${do_remotes[$i]}" "$br"
  done
}

cmd_pull() {
  local root=$1
  shift
  stack_ensure_file "$root"
  require_python3
  stack_scope_parse_args "$root" "$@" || {
    echo "Usage: grov pull [--all] [--yes] [--dry-run] [[<branch>|<a>..<b>] [--cascade]]" >&2
    exit 1
  }

  local yes=false dry=false
  [[ "$SCR_YES" == true || "$SCR_ALL" == true ]] && yes=true
  [[ "$SCR_DRY" == true ]] && dry=true

  local branches_list="" header=""
  case "$SCR_MODE" in
    all) header="Pull all pullable branches (parent-before-child):" ;;
    single) header="Pull '${SCR_ARG}':" ;;
    cascade) header="Pull '${SCR_ARG}' and descendants (parent-before-child):" ;;
    range) header="Pull chain '${SCR_FROM}..${SCR_TO}' (parent-before-child):" ;;
  esac
  branches_list=$(stack_scope_resolve_branches "$root") || exit 1
  [[ "$SCR_MODE" == "range" ]] && [[ -z "$branches_list" ]] && exit 1

  echo "$header"
  local -a planned_branches=()
  while IFS= read -r br; do
    [[ -z "$br" ]] && continue
    planned_branches+=("$br")
  done <<<"$branches_list"

  local -a do_branches=() do_wtpaths=()
  local br wt_path info d ahead behind ab ab_msg
  for br in "${planned_branches[@]}"; do
    materialize_worktree_if_needed "$root" "$br"
    info=$(resolve_dirs_for_branch_head "$root" "$br")
    d=${info#* }
    wt_path=$(readlink -f "$(get_worktree_path "$root" "${d%% *}")" 2>/dev/null || get_worktree_path "$root" "${d%% *}")
    if worktree_in_rebase "$wt_path"; then
      echo "  $br: rebase in progress (skip pull)"
      continue
    fi
    if ! push_resolve_upstream "$wt_path" "$br" &>/dev/null; then
      echo "  $br: no upstream"
      continue
    fi
    ab=$(push_ahead_behind "$wt_path" "$br")
    ahead=${ab%% *}
    behind=${ab#* }
    if [[ "$behind" == "0" ]]; then
      if [[ "$ahead" == "0" ]]; then
        echo "  $br: up to date"
      else
        echo "  $br: ahead $ahead (nothing to pull)"
      fi
      continue
    fi
    ab_msg="behind $behind"
    [[ "$ahead" != "0" ]] && ab_msg="ahead $ahead, $ab_msg"
    echo "  $br: $ab_msg"
    do_branches+=("$br")
    do_wtpaths+=("$wt_path")
  done

  local n=${#do_branches[@]}
  [[ "$n" -eq 0 ]] && return 0

  if [[ "$dry" == true ]]; then
    local i
    for ((i = 0; i < n; i++)); do
      echo "    dry-run: git -C \"${do_wtpaths[$i]}\" pull"
    done
    return 0
  fi

  if [[ "$yes" != true ]]; then
    echo -n "Pull $n branch(es)? [y/N] "
    read -r ans </dev/tty
    [[ "$ans" != [yY]* ]] && return 0
  fi

  local i
  for ((i = 0; i < n; i++)); do
    br="${do_branches[$i]}"
    wt_path="${do_wtpaths[$i]}"
    echo "  $br: pulling"
    git -C "$wt_path" pull || exit 1
  done
}

cmd_parent() {
  local root=$1
  shift
  local yes=false
  local skip_rebase=false
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) yes=true ;;
      --no-rebase) skip_rebase=true ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *) positional+=("$1") ;;
    esac
    shift
  done
  local child="${positional[0]:-}"
  local newp="${positional[1]:-}"
  [[ -z "$child" ]] && echo "Usage: grov parent <child> [<parent>] [--yes] [--no-rebase]" >&2 && exit 1
  stack_ensure_file "$root"

  if [[ -z "$newp" ]]; then
    newp=$(resolve_base "$root")
    [[ -z "$newp" ]] && {
      echo "Error: No parent given and no base set. Use: grov base <branch>" >&2
      exit 1
    }
  fi

  [[ "$child" == "$newp" ]] && echo "Error: child and parent are the same ($child)." >&2 && exit 1

  resolve_branch_ref "$root" "$child" >/dev/null || {
    echo "Error: Branch '$child' not found." >&2
    exit 1
  }
  resolve_branch_ref "$root" "$newp" >/dev/null || {
    echo "Error: Parent branch '$newp' not found." >&2
    exit 1
  }

  local oldp
  oldp=$(stack_get_parent "$root" "$child")

  if [[ -n "$oldp" && "$oldp" == "$newp" ]]; then
    echo "$child already has parent '$newp'. Nothing to do."
    return 0
  fi

  if [[ -n "$oldp" && "$yes" != true ]]; then
    echo -n "Switch parent of '$child' from '$oldp' to '$newp'? [y/N] "
    read -r ans
    [[ "$ans" != [yY]* ]] && { echo "Aborted."; exit 1; }
  fi

  stack_set_parent "$root" "$child" "$newp"

  if [[ -z "$oldp" ]]; then
    echo "Added '$child' to stack with parent '$newp'."
  else
    echo "Reparented '$child': $oldp -> $newp"
  fi

  if [[ "$skip_rebase" == true ]]; then
    echo "Skipping rebase. Run 'grov restack' later if needed."
    return 0
  fi

  materialize_worktree_if_needed "$root" "$child"
  local info wt_folder wt_path
  info=$(resolve_dirs_for_branch_head "$root" "$child")
  wt_folder=${info#* }
  wt_folder=${wt_folder%% *}
  wt_path=$(readlink -f "$(get_worktree_path "$root" "$wt_folder")")

  if [[ -n "$oldp" ]]; then
    if git -C "$wt_path" rebase --onto "$newp" "$oldp"; then
      echo "Rebase complete."
    else
      echo "Conflict during rebase. Resolve in: $wt_path" >&2
      echo "Then: grov restack --continue" >&2
      exit 1
    fi
  else
    if git -C "$wt_path" rebase "$newp"; then
      echo "Rebase complete."
    else
      echo "Conflict during rebase. Resolve in: $wt_path" >&2
      exit 1
    fi
  fi
}

cmd_base() {
  local root=$1
  shift
  local new_base="${1:-}"
  if [[ -z "$new_base" ]]; then
    local b
    b=$(stack_get_base "$root")
    if [[ -n "$b" ]]; then
      echo "$b"
    else
      local fallback
      fallback=$(cat "$root/.grov/primary-branch" 2>/dev/null) || true
      if [[ -n "$fallback" ]]; then
        echo "$fallback (default; not explicitly set)"
      else
        echo "(not set)"
      fi
    fi
    return 0
  fi
  resolve_branch_ref "$root" "$new_base" >/dev/null || {
    echo "Error: Branch '$new_base' not found." >&2
    exit 1
  }
  stack_set_base "$root" "$new_base"
  echo "Base set to '$new_base'."
}

cmd_stack_remove() {
  local root=$1
  shift
  local branch="$1"
  [[ -z "$branch" ]] && echo "Usage: grov stack remove <branch>" >&2 && exit 1
  stack_has_children "$root" "$branch" && {
    echo "Error: '$branch' is not a leaf (has children in stack)." >&2
    exit 1
  }
  cmd_remove "$root" "$branch"
}

cmd_stack_doctor() {
  local root=$1
  stack_ensure_file "$root"
  require_python3
  python3 - "$root" <<'PY'
import json, os, subprocess, sys

root = sys.argv[1]
with open(os.path.join(root, ".grov", "stack.json")) as f:
    d = json.load(f)
nodes = d.get("nodes") or {}
print("stack.json OK; nodes:", len(nodes))
scan = {}
for name in sorted(os.listdir(os.path.join(root, "branches"))):
    p = os.path.join(root, "branches", name)
    if not os.path.isdir(p):
        continue
    try:
        h = subprocess.check_output(
            ["git", "-C", p, "rev-parse", "--abbrev-ref", "HEAD"], text=True
        ).strip()
    except subprocess.CalledProcessError:
        h = "?"
    scan[name] = h

for b, meta in sorted(nodes.items()):
    hint = meta.get("worktree_dir") or ""
    folders = [fd for fd, h in scan.items() if h == b]
    if len(folders) != 1 and hint:
        print(f"- {b}: hint dir '{hint}', scan folders for HEAD={b}: {folders}")
    elif not folders:
        print(f"- {b}: no local worktree (ok)")
PY
}

cmd_restore() {
  local root=$1
  if [[ ! -d "$root/$BARE_REPO" ]]; then
    echo "Error: Not a grov project (no $BARE_REPO)." >&2
    exit 1
  fi
  ensure_workspace "$root" || { echo "Error: No workspace linked." >&2; exit 1; }
  local linked_dir
  linked_dir=$(get_linked_branch "$root")
  [[ -z "$linked_dir" ]] && { echo "Error: Could not get linked branch." >&2; exit 1; }
  local linked_wt="$root/$BRANCHES_DIR_NAME/$linked_dir"
  [[ ! -d "$linked_wt" ]] && { echo "Error: Worktree $linked_wt not found." >&2; exit 1; }
  local primary_branch
  primary_branch=$(cat "$root/.grov/primary-branch" 2>/dev/null) || true
  local linked_branch
  linked_branch=$(git -C "$linked_wt" rev-parse --abbrev-ref HEAD 2>/dev/null) || true
  [[ -z "$linked_branch" ]] && linked_branch="${primary_branch:-master}"
  local tmp="$root/.grov-restore-tmp"
  git clone --local "$root/$BARE_REPO" "$tmp" -b "$linked_branch" || {
    echo "Error: Clone from bare failed." >&2
    exit 1
  }
  local bare="$root/$BARE_REPO"
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    url=$(git --git-dir="$bare" config --get "remote.$name.url" 2>/dev/null)
    [[ -z "$url" ]] && continue
    if [[ "$name" == "origin" ]]; then
      git -C "$tmp" remote set-url origin "$url"
    else
      git -C "$tmp" remote add "$name" "$url" 2>/dev/null || git -C "$tmp" remote set-url "$name" "$url"
      git --git-dir="$bare" config --get-all "remote.$name.fetch" 2>/dev/null | while IFS= read -r refspec; do
        [[ -n "$refspec" ]] && git -C "$tmp" config --add "remote.$name.fetch" "$refspec"
      done
    fi
  done < <(git --git-dir="$bare" remote 2>/dev/null)
  cd /tmp 2>/dev/null || cd "$root/.." || true
  mounts_ensure_file "$root" 2>/dev/null || true
  local mname
  while IFS= read -r mname; do
    [[ -z "$mname" ]] && continue
    [[ -L "$root/$mname" || -e "$root/$mname" ]] && rm -f "$root/$mname"
  done < <(mounts_list_names "$root" 2>/dev/null || true)
  rm -rf "$root/.grov" "$root/$BRANCHES_DIR_NAME" || {
    echo "Error: Failed to remove .grov or branches." >&2
    rm -rf "$tmp"
    exit 1
  }
  for f in "$root"/* "$root"/.[!.]* "$root"/..?*; do
    [[ -e "$f" && "$f" != "$tmp" ]] && rm -rf "$f"
  done
  mv "$tmp/.git" "$root/.git"
  (cd "$tmp" && shopt -s dotglob nullglob 2>/dev/null; for f in *; do
    [[ -z "$f" || "$f" == ".git" ]] && continue
    [[ -e "$f" ]] && mv "$f" "$root/$f"
  done)
  rm -rf "$tmp"
  echo "Restored to normal git repo (branch $linked_branch at root)."
}

# Main: init does not require grov root
cmd="${1:-}"
shift || true
if [[ "$cmd" == "init" ]]; then
  cmd_init
  exit 0
fi

_raw_root=$(find_dev_root) || {
  echo "Error: Cannot find grov root (no .grov in path and GROV_ROOT not set)." >&2
  exit 1
}
GROV_ROOT=$(cd "${_raw_root%%[[:space:]]*}" && pwd)

if [[ "$cmd" == "stack" ]]; then
  sub="${1:-}"
  shift || true
  case "$sub" in
    remove) cmd_stack_remove "$GROV_ROOT" "$@" ;;
    doctor) cmd_stack_doctor "$GROV_ROOT" ;;
    "") echo "Usage: grov stack remove <branch> | grov stack doctor" >&2; exit 1 ;;
    *) echo "Unknown stack subcommand: $sub" >&2; exit 1 ;;
  esac
  exit 0
fi

case "$cmd" in
  checkout)   cmd_checkout "$GROV_ROOT" "$@" ;;
  switch)     cmd_switch "$GROV_ROOT" "$@" ;;
  add)        cmd_add "$GROV_ROOT" "$@" ;;
  status)     cmd_status "$GROV_ROOT" "$@" ;;
  remove)     cmd_remove "$GROV_ROOT" "$@" ;;
  restack)    cmd_restack "$GROV_ROOT" "$@" ;;
  push)       cmd_push "$GROV_ROOT" "$@" ;;
  pull)       cmd_pull "$GROV_ROOT" "$@" ;;
  mount)      cmd_mount "$GROV_ROOT" "$@" ;;
  unmount)    cmd_unmount "$GROV_ROOT" "$@" ;;
  mounts)     cmd_mounts "$GROV_ROOT" ;;
  work)       cmd_work "$GROV_ROOT" "$@" ;;
  merge)      cmd_merge "$GROV_ROOT" "$@" ;;
  exec)       cmd_exec "$GROV_ROOT" "$@" ;;
  parent)     cmd_parent "$GROV_ROOT" "$@" ;;
  base)       cmd_base "$GROV_ROOT" "$@" ;;
  root)       cmd_root "$GROV_ROOT" ;;
  branch)     cmd_branch "$GROV_ROOT" ;;
  branches)   cmd_branches "$GROV_ROOT" ;;
  path)       cmd_path "$GROV_ROOT" "$@" ;;
  restore)    cmd_restore "$GROV_ROOT" ;;
  scripts)    cmd_scripts "$GROV_ROOT" ;;
  run)        cmd_run "$GROV_ROOT" "$@" ;;
  "")
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    ;;
esac
