cmd_checkout() {
  local root=$1
  shift
  local branch="$1"
  [[ "$1" == "-b" ]] && branch="$2"
  [[ -z "$branch" ]] && echo "Usage: grov checkout [-b] <branch>" >&2 && exit 1
  cmd_add "$root" "$@"
  cmd_switch "$root" "$branch"
