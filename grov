cmd_scripts() {
  local root=$1
  local dir="$root/.grov/scripts"
  [[ ! -d "$dir" ]] && return 0
  local f
  for f in "$dir"/*; do
    [[ -f "$f" && -x "$f" ]] && basename "$f"
  done | sort
}

cmd_run() {
  local root=$1
  shift
  local name="${1:-}"
  [[ -z "$name" ]] && echo "Usage: grov run <name> [args...]" >&2 && exit 1
  shift
  local script_path="$root/.grov/scripts/$name"
  if [[ ! -e "$script_path" ]]; then
    echo "Error: No script at $script_path" >&2
    exit 1
  fi
  if [[ ! -x "$script_path" ]]; then
    echo "Script exists but is not executable: $script_path" >&2
    echo -n "Make it executable? [y/N] " >&2
    read -r ans
    [[ "$ans" != [yY]* ]] && exit 1
    chmod +x "$script_path"
