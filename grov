#!/usr/bin/env bash
# Grov CLI: worktrees, workspace symlink, stacked branch metadata, .grov/scripts.
#
# Install: run ./install from this repo (or ln -sf path/to/grov/grov ~/bin/grov).
# Usage: grov <command> [args...]
#   init                    convert current git repo to dev layout (bare at .grov/repo.git)
#   checkout [-b] <branch>  ensure worktree exists, point workspace at it
#   switch <branch>         point workspace at existing worktree only
#   add [-b] <branch>       create worktree only (no link change)
#   status [--no-fetch]     list worktrees, stack tree, linked branch, git state (fetches by default)
#   remove <branch>         remove a worktree (stack leaf only if branch is in stack)
#   restack [--all] [--yes] [--continue|--abort] [[<branch>|<a>..<b>] [--cascade]]   rebase onto parents (ordered)
#   push [--all] [--yes] [--dry-run] [[<branch>|<a>..<b>] [--cascade]]   push with --force-with-lease (default: all pushable, prompt)
#   pull [--all] [--yes] [--dry-run] [[<branch>|<a>..<b>] [--cascade]]   git pull upstream (default: all pullable, prompt)
#   remove [--yes] <branch>|<a>..<b> [--cascade]   remove worktree(s); default one branch; no --all
#   parent <child> [parent] [--yes] [--no-rebase]   add/move branch in stack (defaults parent to base)
#   base [<branch>]         show or set the global base (trunk) branch
#   stack remove <branch>   remove leaf from stack metadata + worktree
#   stack doctor            validate stack.json vs worktrees
#   root                    print grov project root
#   branch                  print active (linked) branch name
#   branches                list worktree branch names
#   path [branch]           print active workspace path, or path to branch worktree
#   mount <name> <branch>   add optional mount symlink at repo root
#   unmount <name>          remove an optional mount (not workspace)
#   mounts                  list mounts (workspace is required)
#   work [<target>]         subshell in a worktree (default: workspace mount; no mount change)
#   merge [<branch-a>] [<branch-b>]   merge branch-a into branch-b (default target: workspace)
#   exec <branch> -- <cmd...>   run a command in a branch worktree (no link change)
#   scripts                 list custom scripts in .grov/scripts
#   run <name> [args...]    run .grov/scripts/<name>

set -e
LINK_NAME="workspace"
WORKSPACE_MOUNT="workspace"
BRANCHES_DIR_NAME="branches"
BARE_REPO=".grov/repo.git"
STACK_JSON=".grov/stack.json"
MOUNTS_JSON=".grov/mounts.json"

require_python3() {
  command -v python3 &>/dev/null || {
    echo "Error: python3 is required for grov stack features (.grov/stack.json)." >&2
    exit 1
  }
}

stack_path() {
  echo "$1/$STACK_JSON"
}

stack_ensure_file() {
  local root=$1
  local p
  p=$(stack_path "$root")
  [[ -f "$p" ]] && return 0
  mkdir -p "$root/.grov"
  printf '%s\n' '{"version":1,"nodes":{}}' >"$p"
}

stack_get_base() {
  local root=$1
  require_python3
  stack_ensure_file "$root"
  python3 - "$root" <<'PY'
import json, sys
root = sys.argv[1]
with open(f"{root}/.grov/stack.json") as f:
    d = json.load(f)
print(d.get("base") or "")
PY
}

stack_set_base() {
  local root=$1
  local base=$2
  require_python3
  stack_ensure_file "$root"
  python3 - "$root" "$base" <<'PY'
import json, sys
root, base = sys.argv[1:3]
path = f"{root}/.grov/stack.json"
with open(path) as f:
    d = json.load(f)
if base:
    d["base"] = base
else:
    d.pop("base", None)
with open(path, "w") as f:
    json.dump(d, f, indent=2)
PY
}

resolve_base() {
  local root=$1
  local b
  b=$(stack_get_base "$root")
  if [[ -z "$b" ]]; then
    b=$(cat "$root/.grov/primary-branch" 2>/dev/null) || true
  fi
  echo "$b"
}

mounts_path() {
  echo "$1/$MOUNTS_JSON"
}

mounts_ensure_file() {
  local root=$1
  local p
  p=$(mounts_path "$root")
  if [[ -f "$p" ]]; then return 0; fi
  require_python3
  mkdir -p "$root/.grov"
  python3 - "$root" "$WORKSPACE_MOUNT" "$LINK_NAME" "$BRANCHES_DIR_NAME" <<'PY'
import json, os, sys
root, ws_name, link_name, branches = sys.argv[1:5]
folder = ""
link = os.path.join(root, link_name)
if os.path.islink(link):
    target = os.readlink(link)
    folder = os.path.basename(target.rstrip("/"))
if not folder:
    bd = os.path.join(root, branches)
    if os.path.isdir(bd):
        for name in sorted(os.listdir(bd)):
            if os.path.isdir(os.path.join(bd, name)):
                folder = name
                break
mounts = {ws_name: folder} if folder else {ws_name: ""}
with open(os.path.join(root, ".grov", "mounts.json"), "w") as f:
    json.dump({"version": 1, "mounts": mounts}, f, indent=2)
PY
}

mounts_get_folder() {
  local root=$1
  local mount_name=$2
  require_python3
  mounts_ensure_file "$root"
  python3 - "$root" "$mount_name" <<'PY'
import json, sys
root, name = sys.argv[1:3]
with open(f"{root}/.grov/mounts.json") as f:
    d = json.load(f)
print((d.get("mounts") or {}).get(name) or "")
PY
}

mounts_list_names() {
  local root=$1
  require_python3
  mounts_ensure_file "$root"
  python3 - "$root" <<'PY'
import json, sys
root = sys.argv[1]
with open(f"{root}/.grov/mounts.json") as f:
    mounts = json.load(f).get("mounts") or {}
for name in sorted(mounts.keys()):
    print(name)
PY
}

mounts_set_folder() {
  local root=$1
  local mount_name=$2
  local folder=$3
  require_python3
  mounts_ensure_file "$root"
  python3 - "$root" "$mount_name" "$folder" <<'PY'
import json, sys
root, name, folder = sys.argv[1:4]
path = f"{root}/.grov/mounts.json"
with open(path) as f:
    d = json.load(f)
mounts = d.setdefault("mounts", {})
mounts[name] = folder
with open(path, "w") as f:
    json.dump(d, f, indent=2)
PY
}

mounts_remove_name() {
  local root=$1
  local mount_name=$2
  require_python3
  python3 - "$root" "$mount_name" <<'PY'
import json, sys
root, name = sys.argv[1:3]
path = f"{root}/.grov/mounts.json"
with open(path) as f:
    d = json.load(f)
mounts = d.setdefault("mounts", {})
mounts.pop(name, None)
with open(path, "w") as f:
    json.dump(d, f, indent=2)
PY
}

mount_name_valid() {
  local name=$1
  [[ "$name" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]] || return 1
  [[ "$name" != "$BRANCHES_DIR_NAME" && "$name" != ".grov" && "$name" != ".git" ]] || return 1
  return 0
}

apply_mount_symlink() {
  local root=$1
  local mount_name=$2
  local folder=$3
  local link_path
  link_path=$(cd "$root" && pwd)/$mount_name
  ln -sfn "$BRANCHES_DIR_NAME/$folder" "$link_path"
}

set_workspace_mount() {
  local root=$1
  local folder=$2
  mounts_set_folder "$root" "$WORKSPACE_MOUNT" "$folder"
  apply_mount_symlink "$root" "$WORKSPACE_MOUNT" "$folder"
}

# Resolve mount name, git branch, or worktree folder to a folder under branches/.
resolve_target_folder() {
  local root=$1
  local target=$2
  local folder
  mounts_ensure_file "$root"
  folder=$(mounts_get_folder "$root" "$target")
  if [[ -n "$folder" ]]; then
    echo "$folder"
    return 0
  fi
  folder=$(resolve_worktree_folder "$root" "$target" 2>/dev/null) || folder="$target"
  if [[ -d "$(get_worktree_path "$root" "$folder")" ]]; then
    echo "$folder"
    return 0
  fi
  return 1
}

stack_get_parent() {
  local root=$1
  local child=$2
  require_python3
  stack_ensure_file "$root"
  python3 - "$root" "$child" <<'PY'
import json, sys
root, ch = sys.argv[1:3]
with open(f"{root}/.grov/stack.json") as f:
    d = json.load(f)
nodes = d.get("nodes") or {}
print(nodes.get(ch, {}).get("parent") or "")
PY
}

# Record new stacked branch after grov add/checkout -b (parent = linked worktree HEAD).
stack_record_new_branch() {
  local root=$1
  local child_branch=$2
  local worktree_dir=$3
  local linked
  linked=$(get_linked_branch "$root" 2>/dev/null) || true
  [[ -z "$linked" ]] && return 0
  local pwt
  pwt="$root/$BRANCHES_DIR_NAME/$linked"
  [[ ! -d "$pwt" ]] && return 0
  local parent_git
  parent_git=$(git -C "$pwt" rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
  [[ -z "$parent_git" || "$parent_git" == "HEAD" ]] && return 0
  require_python3
  stack_ensure_file "$root"
  python3 - "$root" "$child_branch" "$parent_git" "$worktree_dir" <<'PY'
import json, sys
root, child, parent, wt = sys.argv[1:5]
path = f"{root}/.grov/stack.json"
with open(path) as f:
    d = json.load(f)
nodes = d.setdefault("nodes", {})
nodes[child] = {"parent": parent, "worktree_dir": wt}
with open(path, "w") as f:
    json.dump(d, f, indent=2)
PY
}

stack_load_nodes_python() {
  python3 - "$@" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as f:
    d = json.load(f)
nodes = d.get("nodes") or {}
for name in sorted(nodes.keys()):
    meta = nodes[name]
    p = meta.get("parent")
    wt = meta.get("worktree_dir") or ""
    print(f"{name}\t{p if p is not None else ''}\t{wt}")
PY
}

stack_json_dump_nodes() {
  local root=$1
  stack_ensure_file "$root"
  stack_load_nodes_python "$(stack_path "$root")"
}

stack_children_of() {
  local root=$1
  local parent=$2
  stack_json_dump_nodes "$root" | while IFS=$'\t' read -r name p _; do
    [[ "$p" == "$parent" ]] && echo "$name"
  done
}

stack_has_children() {
  local root=$1
  local branch=$2
  [[ -n $(stack_children_of "$root" "$branch") ]]
}

stack_remove_node() {
  local root=$1
  local branch=$2
  require_python3
  stack_ensure_file "$root"
  python3 - "$root" "$branch" <<'PY'
import json, sys
root, br = sys.argv[1:3]
path = f"{root}/.grov/stack.json"
with open(path) as f:
    d = json.load(f)
nodes = d.setdefault("nodes", {})
nodes.pop(br, None)
with open(path, "w") as f:
    json.dump(d, f, indent=2)
PY
}

stack_set_parent() {
  local root=$1
  local child=$2
  local new_parent=$3
  require_python3
  stack_ensure_file "$root"
  python3 - "$root" "$child" "$new_parent" <<'PY'
import json, sys
root, child, newp = sys.argv[1:4]
path = f"{root}/.grov/stack.json"
with open(path) as f:
    d = json.load(f)
nodes = d.setdefault("nodes", {})
if child not in nodes:
    nodes[child] = {}
nodes[child]["parent"] = newp
with open(path, "w") as f:
    json.dump(d, f, indent=2)
PY
}

# Lines: folder<TAB>head_branch
scan_worktrees_head() {
  local root=$1
  local dir wt_path head
  dir="$root/$BRANCHES_DIR_NAME"
  [[ ! -d "$dir" ]] && return 0
  local d
  for d in "$dir"/*/; do
    [[ -d "$d" ]] || continue
    wt_path=$(readlink -f "$d" 2>/dev/null || echo "$d")
    [[ ! -d "$wt_path" ]] && continue
    git -C "$wt_path" rev-parse --is-inside-work-tree &>/dev/null || continue
    head=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null) || head="?"
    echo "$(basename "$d")"$'\t'"$head"
  done | sort
}

# Echo branches/<folder> basename for a git branch (works during rebase / detached HEAD).
resolve_worktree_folder() {
  local root=$1
  local git_branch=$2
  local folder head wt_path gp rb_branch
  while IFS=$'\t' read -r folder head; do
    [[ "$head" == "$git_branch" ]] && echo "$folder" && return 0
  done < <(scan_worktrees_head "$root")
  local dir="$root/$BRANCHES_DIR_NAME"
  [[ ! -d "$dir" ]] && return 1
  for d in "$dir"/*/; do
    [[ -d "$d" ]] || continue
    wt_path=$(readlink -f "$d" 2>/dev/null || echo "$d")
    folder=$(basename "$d")
    for sub in rebase-merge rebase-apply; do
      gp=$(git -C "$wt_path" rev-parse --git-path "$sub" 2>/dev/null || true)
      if [[ -n "$gp" && -d "$gp" && -f "$gp/head-name" ]]; then
        rb_branch=$(sed 's|^refs/heads/||' <"$gp/head-name")
        [[ "$rb_branch" == "$git_branch" ]] && echo "$folder" && return 0
      fi
    done
  done
  require_python3
  stack_ensure_file "$root"
  folder=$(python3 - "$root" "$git_branch" <<'PY'
import json, os, sys
root, br = sys.argv[1:3]
with open(os.path.join(root, ".grov", "stack.json")) as f:
    nodes = json.load(f).get("nodes") or {}
meta = nodes.get(br) or {}
candidates = []
if meta.get("worktree_dir"):
    candidates.append(meta["worktree_dir"])
if br not in candidates:
    candidates.append(br)
for c in candidates:
    if os.path.isdir(os.path.join(root, "branches", c)):
        print(c)
        sys.exit(0)
sys.exit(1)
PY
) || true
  [[ -n "$folder" ]] && echo "$folder" && return 0
  return 1
}

# Echo "local_ref upstream_ref" for ahead/behind (branch ref, not detached HEAD).
push_resolve_upstream() {
  local wt=$1
  local branch=$2
  local upstream gp sub
  if [[ -z "$branch" ]] || ! git -C "$wt" rev-parse --verify "$branch" &>/dev/null; then
    branch=""
    for sub in rebase-merge rebase-apply; do
      gp=$(git -C "$wt" rev-parse --git-path "$sub" 2>/dev/null || true)
      if [[ -n "$gp" && -f "$gp/head-name" ]]; then
        branch=$(sed 's|^refs/heads/||' <"$gp/head-name")
        break
      fi
    done
    if [[ -z "$branch" ]]; then
      branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
      [[ "$branch" == "HEAD" ]] && branch=""
    fi
  fi
  if [[ -n "$branch" ]]; then
    upstream=$(git -C "$wt" rev-parse --abbrev-ref "${branch}@{upstream}" 2>/dev/null) || true
    if [[ -n "$upstream" ]]; then
      echo "$branch $upstream"
      return 0
    fi
    if git -C "$wt" rev-parse --verify "origin/$branch" &>/dev/null; then
      echo "$branch origin/$branch"
      return 0
    fi
  fi
  if git -C "$wt" rev-parse @{u} &>/dev/null; then
    echo "HEAD @{u}"
    return 0
  fi
  return 1
}

# Echo "ahead behind" (space-separated).
push_ahead_behind() {
  local wt=$1
  local branch=$2
  local refs local_ref upstream ahead behind
  refs=$(push_resolve_upstream "$wt" "$branch") || { echo "0 0"; return 1; }
  local_ref=${refs%% *}
  upstream=${refs#* }
  ahead=$(git -C "$wt" rev-list --count "${upstream}..${local_ref}" 2>/dev/null || echo "0")
  behind=$(git -C "$wt" rev-list --count "${local_ref}..${upstream}" 2>/dev/null || echo "0")
  echo "$ahead $behind"
}

get_primary_dir() {
  local root=$1
  cat "$root/.grov/primary-dir" 2>/dev/null || echo "master"
}

find_dev_root() {
  local d="$PWD"
  while [[ -n "$d" && "$d" != "/" ]]; do
    [[ -e "$d/.grov" ]] && echo "$d" && return 0
    d="${d%/*}"
  done
  [[ -n "$GROV_ROOT" && -e "$GROV_ROOT/.grov" ]] && echo "$GROV_ROOT" && return 0
  local script_path
  script_path=$(readlink -f "$0" 2>/dev/null || true)
  if [[ -n "$script_path" ]]; then
    d=$(dirname "$script_path")
    d=$(dirname "$d")
    [[ -e "$d/.grov" ]] && echo "$d" && return 0
  fi
  return 1
}

ensure_workspace() {
  local root=$1
  mounts_ensure_file "$root" || return 1
  local folder
  folder=$(mounts_get_folder "$root" "$WORKSPACE_MOUNT")
  [[ -z "$folder" ]] && return 1
  local wt_path
  wt_path=$(get_worktree_path "$root" "$folder")
  [[ ! -d "$wt_path" ]] && return 1
  apply_mount_symlink "$root" "$WORKSPACE_MOUNT" "$folder"
  return 0
}

get_linked_branch() {
  local root=$1
  ensure_workspace "$root" || true
  local folder
  folder=$(mounts_get_folder "$root" "$WORKSPACE_MOUNT" 2>/dev/null) || true
  [[ -n "$folder" ]] && echo "$folder" && return 0
  local link_path target
  link_path=$(cd "$root" && pwd)/$LINK_NAME
  if [[ ! -L "$link_path" ]]; then echo ""; return 1; fi
  target=$(readlink -f "$link_path")
  [[ -z "$target" ]] && echo "" && return 1
  basename "$target"
}

# Git branch name checked out in linked workspace (may differ from linked folder basename).
get_linked_git_branch() {
  local root=$1
  local folder wt_path
  folder=$(get_linked_branch "$root") || return 1
  [[ -z "$folder" ]] && return 1
  wt_path=$(get_worktree_path "$root" "$folder")
  [[ ! -d "$wt_path" ]] && return 1
  git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null
}

get_current_branch_from_cwd() {
  local root=$1
  local branches="$root/$BRANCHES_DIR_NAME"
  if [[ "$PWD" != "$branches"/* ]]; then
    echo ""; return 1
  fi
  local rest="${PWD#$branches/}"
  echo "${rest%%/*}"
}

get_worktree_path() {
  echo "$1/$BRANCHES_DIR_NAME/$2"
}

list_branch_dirs() {
  local root=$1
  local dir="$root/$BRANCHES_DIR_NAME"
  [[ ! -d "$dir" ]] && return 0
  local d
  for d in "$dir"/*/; do
    [[ -d "$d" ]] && basename "$d"
  done | sort
}

usage() {
  echo "Usage: grov <command> [args...]"
  echo "  init                     convert current git repo to grov layout"
  echo "  restore                  convert grov project back to normal git repo"
  echo "  checkout [-b] <branch>   ensure worktree exists, point workspace at it"
  echo "  switch <branch>          point workspace at existing worktree only"
  echo "  add [-b] <branch>        create worktree only (no link change)"
  echo "  status [--no-fetch]      list worktrees, stack tree, git state (fetches by default)"
  echo "  remove [--yes] <branch>|<a>..<b> [--cascade]   remove worktree(s); no --all"
  echo "  restack [--all] [--yes] [--continue|--abort] [[branch|<a>..<b>] [--single]]"
  echo "  push [--all] [--yes] [--dry-run] [[branch|<a>..<b>] [--cascade]]   (default: all pushable, prompt)"
  echo "  pull [--all] [--yes] [--dry-run] [[branch|<a>..<b>] [--cascade]]   (default: all pullable, prompt)"
  echo "  parent <child> [parent] [--yes] [--no-rebase]   add/move branch in stack (default parent=base)"
  echo "  base [<branch>]          show or set the global base (trunk) branch"
  echo "  stack remove <branch>    remove stack leaf + worktree"
  echo "  stack doctor             validate stack.json vs branches/"
  echo "  mount <name> <branch>    add optional mount symlink at repo root"
  echo "  unmount <name>           remove optional mount (not workspace)"
  echo "  mounts                   list mounts"
  echo "  work [<target>]          subshell in worktree (default: workspace; mounts unchanged)"
  echo "  merge [<branch-a>] [<branch-b>]   merge branch-a into branch-b (default target: workspace)"
  echo "  exec <branch> -- <cmd...>   run command in worktree (no link change)"
  echo "  root | branch | branches | path | scripts"
  echo "  run <name> [args...]     run .grov/scripts/<name>"
  exit 1
}

has_bare() { [[ -d "$1/$BARE_REPO" ]]; }

# Resolve branch to a ref (local branch name or origin/branch). Echoes ref and returns 0 if found, else return 1.
resolve_branch_ref() {
  local root=$1
  local branch=$2
  local bare="$root/$BARE_REPO"
  if has_bare "$root"; then
    if git --git-dir="$bare" rev-parse --verify "$branch" &>/dev/null; then
      echo "$branch"; return 0
    fi
    git --git-dir="$bare" fetch origin &>/dev/null || true
    if git --git-dir="$bare" rev-parse --verify "origin/$branch" &>/dev/null; then
      echo "origin/$branch"; return 0
    fi
  else
    local primary_dir
    primary_dir=$(get_primary_dir "$root")
    local repo="$root/$BRANCHES_DIR_NAME/$primary_dir"
    [[ ! -d "$repo/.git" ]] && return 1
    if git -C "$repo" rev-parse --verify "$branch" &>/dev/null; then
      echo "$branch"; return 0
    fi
    git -C "$repo" fetch origin &>/dev/null || true
    if git -C "$repo" rev-parse --verify "origin/$branch" &>/dev/null; then
      echo "origin/$branch"; return 0
    fi
  fi
  return 1
}

ensure_worktree() {
  local root=$1
  local create_branch=$2
  local branch=$3
  local wt_path
  wt_path=$(cd "$root" && pwd)/$BRANCHES_DIR_NAME/$branch
  local bare="$root/$BARE_REPO"
  if has_bare "$root"; then
    if [[ ! -d "$wt_path" ]]; then
      if [[ "$create_branch" == true ]]; then
        local src
        src=$(get_linked_branch "$root")
        [[ -z "$src" ]] && src="HEAD"
        git --git-dir="$bare" worktree add -b "$branch" "$wt_path" "$src"
        echo "Created branch '$branch' and worktree at $wt_path"
        stack_record_new_branch "$root" "$branch" "$branch"
      else
        local ref
        ref=$(resolve_branch_ref "$root" "$branch") || {
          echo "Error: Branch '$branch' does not exist. Use: grov checkout -b <branch>" >&2
          exit 1
        }
        if [[ "$ref" == "origin/$branch" ]]; then
          git --git-dir="$bare" worktree add -b "$branch" "$wt_path" "origin/$branch"
          git -C "$wt_path" branch --set-upstream-to="origin/$branch" &>/dev/null || true
          echo "Created worktree at $wt_path (from origin/$branch)"
        else
          git --git-dir="$bare" worktree add "$wt_path" "$branch"
          echo "Created worktree at $wt_path"
        fi
      fi
    fi
  else
    local primary_dir
    primary_dir=$(get_primary_dir "$root")
    local repo="$root/$BRANCHES_DIR_NAME/$primary_dir"
    if [[ ! -d "$repo/.git" ]]; then
      echo "Error: No .grov/repo.git and no primary worktree at $repo. Run grov init first." >&2
      exit 1
    fi
    if [[ -d "$wt_path" ]]; then
      :
    elif [[ "$create_branch" == true ]]; then
      local src
      src=$(get_linked_branch "$root")
      [[ -z "$src" ]] && echo "Error: workspace not linked; cannot use -b." >&2 && exit 1
      git -C "$repo" worktree add -b "$branch" "$wt_path" "$src"
      echo "Created branch '$branch' from '$src' and worktree at $wt_path"
      stack_record_new_branch "$root" "$branch" "$branch"
    else
      local ref
      ref=$(resolve_branch_ref "$root" "$branch") || {
        echo "Error: Branch '$branch' does not exist. Use: grov checkout -b <branch>" >&2
        exit 1
      }
      if [[ "$ref" == "origin/$branch" ]]; then
        git -C "$repo" worktree add -b "$branch" "$wt_path" "origin/$branch"
        git -C "$wt_path" branch --set-upstream-to="origin/$branch" &>/dev/null || true
        echo "Created worktree at $wt_path (from origin/$branch)"
      else
        git -C "$repo" worktree add "$wt_path" "$branch"
        echo "Created worktree at $wt_path"
      fi
    fi
  fi
}

cmd_init() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Error: Not inside a git repository. Run grov init from a repo root." >&2
    exit 1
  }
  cd "$root" || exit 1
  if [[ -e "$root/.grov" ]]; then
    echo "Error: Already a grov project (.grov exists)." >&2
    exit 1
  fi
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch="rescue"
  [[ "$branch" == "HEAD" || -z "$branch" ]] && branch="rescue"
  local branch_dir="${branch//[^a-zA-Z0-9._-]/_}"
  mkdir -p .grov/scripts .grov/old-checkout
  echo "$branch_dir" > .grov/primary-dir
  echo "$branch" > .grov/primary-branch
  # Move untracked out first so we don't overwrite them when creating worktree at branches/
  (cd "$root" && git ls-files --others --exclude-standard) | while IFS= read -r f; do
    [[ -n "$f" && -e "$root/$f" ]] || continue
    mkdir -p "$root/.grov/old-checkout/$(dirname "$f")"
    mv "$root/$f" "$root/.grov/old-checkout/$f"
  done
  git init --bare "$BARE_REPO"
  git --git-dir="$root/$BARE_REPO" config rerere.enabled true
  git --git-dir="$root/$BARE_REPO" config rerere.autoupdate true
  (cd "$root" && git remote add _dev_bare "$(pwd)/$BARE_REPO" && git push _dev_bare --all && git push _dev_bare --tags 2>/dev/null; git remote remove _dev_bare 2>/dev/null)
  # Copy remotes from original repo into bare so fetch/push still work
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    url=$(git -C "$root" config --get "remote.$name.url" 2>/dev/null)
    [[ -z "$url" ]] && continue
    git --git-dir="$root/$BARE_REPO" remote add "$name" "$url" 2>/dev/null || true
    git -C "$root" config --get-all "remote.$name.fetch" 2>/dev/null | while IFS= read -r refspec; do
      [[ -n "$refspec" ]] && git --git-dir="$root/$BARE_REPO" config --add "remote.$name.fetch" "$refspec"
    done
  done < <(git -C "$root" remote 2>/dev/null)
  mkdir -p "$BRANCHES_DIR_NAME"
  local wt_path
  wt_path=$(cd "$root" && pwd)/$BRANCHES_DIR_NAME/$branch_dir
  if ! git --git-dir="$root/$BARE_REPO" rev-parse --verify "$branch" &>/dev/null; then
    echo "Error: Branch '$branch' not in bare repo (push may have failed)." >&2
    exit 1
  fi
  git --git-dir="$root/$BARE_REPO" worktree add "$wt_path" "$branch"
  printf '%s\n' "{\"version\":1,\"mounts\":{\"$WORKSPACE_MOUNT\":\"$branch_dir\"}}" >"$root/$MOUNTS_JSON"
  apply_mount_symlink "$root" "$WORKSPACE_MOUNT" "$branch_dir"
  find "$root" -mindepth 1 -maxdepth 1 ! -name .grov ! -name "$BRANCHES_DIR_NAME" ! -name "$LINK_NAME" ! -name .git -exec rm -rf {} +
  rm -rf "$root/.git"
  printf '%s\n' '{"version":1,"nodes":{}}' >"$root/$STACK_JSON"
  echo "Untracked files from previous working tree. Refs in .grov/repo.git; worktree at branches/$branch_dir" > "$root/.grov/old-checkout/README.txt"
  echo "Initialized. workspace -> branches/$branch_dir. Untracked files in .grov/old-checkout."
}

cmd_root() {
